{
  "name": "xray-wasm",
  "version": "0.1.0",
  "description": "Xray-core's own xray command, compiled to WebAssembly from unmodified release tags: check configs like `xray run -test` and run the offline CLI in the browser.",
  "license": "MPL-2.0",
  "author": "bropines",
  "homepage": "https://github.com/bropines/xray-wasm#readme",
  "repository": { "type": "git", "url": "git+https://github.com/bropines/xray-wasm.git" },
  "bugs": { "url": "https://github.com/bropines/xray-wasm/issues" },
  "keywords": ["xray", "xray-core", "xtls", "wasm", "webassembly", "config", "validator", "vless", "reality"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./worker.js": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "src", "README.md", "README.ru.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "wasm:build": "bun scripts/build.ts",
    "wasm:smoke": "bun scripts/smoke.ts",
    "wasm:compare": "bun scripts/compare.ts",
    "versions": "bun scripts/versions.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
